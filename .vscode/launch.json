{
    "version": "0.2.0",
    "configurations": [
        

        
        {
            "type": "java",
            "name": "Inventario (Windows)",
            "request": "launch",
            "mainClass": "com.inventario_pi.App",
            "projectName": "demo",
            "cwd": "${workspaceFolder}/demo",
            "console": "integratedTerminal",
            "env": {
                "DB_PASSWORD": "${input:dbPassword}"
            }
        },
        {
            "type": "java",
            "name": "Inventario (Linux Snap)",
            "request": "launch",
            "mainClass": "com.inventario_pi.App",
            "projectName": "demo",
            "cwd": "${workspaceFolder}/demo",
            "javaExec": "${workspaceFolder}/scripts/java-clean.sh",
            "console": "integratedTerminal",
            "env": {
                "DB_PASSWORD": "${input:dbPassword}"
            }
        }
    ],
    "inputs": [
        {
            "id": "dbPassword",
            "type": "promptString",
            "description": "Contraseña de la base de datos Supabase",
            "password": true
        }
    ]
}
